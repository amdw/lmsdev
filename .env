# MySQL credentials
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=drupal

# Drupal site settings
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASSWORD=admin
DRUPAL_SITE_NAME=LMS Test
DRUPAL_SITE_MAIL=lms@example.com

# Host port for the Drupal web interface (bound to 127.0.0.1 only – use an SSH
# tunnel to reach it from your workstation: ssh -L 8080:localhost:8080 <vm>)
WEB_PORT=8080

# LMS source code lives in the lms/ git submodules within this repo.
